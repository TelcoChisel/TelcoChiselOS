#!/usr/bin/env bash
# =============================================================================
# /usr/local/bin/telcosec-pkg — Official TelcoChisel Metapackage Manager
#
# Provides management of official TelcoChisel telecom security metapackages:
#   - List installed, available, and upgradable metapackages
#   - Install and remove metapackages by name or shorthand alias
#   - Inspect dependencies, recommends, and tool manifests
#   - Verify dependency integrity and repair broken states
#   - Manage official APT repository connection (meta.telcochisel.com)
# =============================================================================
set -euo pipefail

VERSION="1.2.0"
TELCOSEC_URL="https://meta.telcochisel.com"
TELCOSEC_KEY="/etc/apt/keyrings/telcochisel-archive-keyring.asc"
TELCOSEC_SOURCES="/etc/apt/sources.list.d/telcochisel.sources"
TELCOSEC_PREF="/etc/apt/preferences.d/99-telcochisel.pref"
TELCOSEC_FPR="6326A34C15FEF05FBD63518B4325182E2F0D9DB9"

# Terminal styling
if [ -t 1 ]; then
  BOLD='\033[1m'
  CYAN='\033[1;36m'
  GREEN='\033[1;32m'
  YELLOW='\033[1;33m'
  RED='\033[1;31m'
  BLUE='\033[1;34m'
  MAGENTA='\033[1;35m'
  DIM='\033[2m'
  RESET='\033[0m'
else
  BOLD='' CYAN='' GREEN='' YELLOW='' RED='' BLUE='' MAGENTA='' DIM='' RESET=''
fi

# ── Canonical Metapackage Registry ──────────────────────────────────────────
# Order: base -> hardware -> protocol layers -> specialized -> full
METAPACKAGES=(
  "telcochisel-base"
  "telcochisel-hardware-sdr"
  "telcochisel-tools-sdr"
  "telcochisel-tools-2g-3g"
  "telcochisel-tools-4g"
  "telcochisel-tools-5g"
  "telcochisel-tools-sim"
  "telcochisel-tools-pstn-adsl"
  "telcochisel-tools-ue"
  "telcochisel-meta-full"
)

get_pkg_alias() {
  case "$1" in
    telcochisel-base)             echo "base" ;;
    telcochisel-hardware-sdr)     echo "hardware" ;;
    telcochisel-tools-sdr)         echo "sdr" ;;
    telcochisel-tools-2g-3g)       echo "2g-3g" ;;
    telcochisel-tools-4g)          echo "4g" ;;
    telcochisel-tools-5g)          echo "5g" ;;
    telcochisel-tools-sim)         echo "sim" ;;
    telcochisel-tools-pstn-adsl)   echo "wireline" ;;
    telcochisel-tools-ue)          echo "ue" ;;
    telcochisel-meta-full)         echo "full" ;;
    *)                             echo "unknown" ;;
  esac
}

get_pkg_desc() {
  case "$1" in
    telcochisel-base)             echo "Core OS kernel latency tuning, PAM limits, SCTP stack & wordlists" ;;
    telcochisel-hardware-sdr)     echo "SDR USB udev rules & FPGA bitstream loaders (BladeRF, USRP, Lime, Pluto)" ;;
    telcochisel-tools-sdr)         echo "RF analysis & Satcom suite (GNU Radio, Gqrx, Inspectrum, URH, Gpredict, gr-gsm)" ;;
    telcochisel-tools-2g-3g)       echo "Cellular 2G/3G Osmocom infrastructure, YateBTS, OpenBTS & gr-gsm" ;;
    telcochisel-tools-4g)          echo "4G LTE eNodeB/EPC simulation & protocol audit (srsRAN, Open5GS, LTESniffer)" ;;
    telcochisel-tools-5g)          echo "5G SA Core (Open5GS), UERANSIM, mitmproxy (5G SBI) & 5Ghoul fuzzer" ;;
    telcochisel-tools-sim)         echo "SIM & eSIM auditing suite (pySim-shell, SIMtrace 2, lpac, SIMurai, OpenSC, pcsc-tools)" ;;
    telcochisel-tools-pstn-adsl)   echo "Wireline broadband, QinQ, mausezahn, voiphopper, rtpbleed, sipsak, SIPp, DOCSIS" ;;
    telcochisel-tools-ue)          echo "Mobile UE & baseband diagnostics (UERANSIM, SCAT, QCSuper, FirmWire, MTKClient)" ;;
    telcochisel-meta-full)         echo "Complete TelcoChisel telecom security distribution umbrella (100 tools)" ;;
    *)                             echo "Custom or third-party metapackage" ;;
  esac
}

