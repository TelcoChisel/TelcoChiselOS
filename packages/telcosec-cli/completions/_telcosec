#compdef telcosec telcochisel

_telcosec_interfaces() {
    local -a ifaces
    ifaces=(${(f)"$(command ls -1 /sys/class/net 2>/dev/null | grep -v '^lo$')"})
    _describe 'interface' ifaces
}

_telcosec() {
    local -a commands
    commands=(
        'check:Run comprehensive pre-flight healthcheck'
        'status:Display detailed kernel, PAM limits, and service telemetry'
        'hardware:Enumerate and probe attached SDRs, modems, and SIM readers'
        'search:Search installed 100 telecom tools and desktop launchers by keyword'
        'docs:Open offline documentation & operator reference in browser'
        'sdr:SDR drivers, USB & 10GbE management'
        '10g:10Gbps network SDR interface optimization (MTU 9000, ring buffers)'
        'firmware:Inspect and manage offline SDR FPGA bitstreams (BladeRF, USRP)'
        'profile:Switch operational profiles (lab vs field)'
        'pkg:Official metapackage manager (list, info, install, remove, repo)'
        'sim:Smartcard, SIM & eSIM auditing (status, readers, atr, trace, lpac, shell)'
        '5g-sa:5G Standalone core & RAN lifecycle manager (Open5GS)'
        'scan:Interactive telecom protocol assessment wizard (sctp, sip, asleap)'
        'academy:Access TelcoSec Academy interactive labs & credentials'
        'feedback:Community support channels & SourceForge review portal'
        'completion:Generate shell autocompletion script (bash, zsh, fish)'
        'version:Show TelcoChiselOS release version and kernel details'
        'help:Show help and command usage'
    )

    _arguments -C \
        '1: :->command' \
        '*:: :->args'

    case $state in
        command)
            _describe -t commands 'telcosec command' commands
            ;;
        args)
            case $words[1] in
                sim|smartcard|esim)
                    local -a sim_subcmds
                    sim_subcmds=(
                        'status:Audit smartcard daemon, reader count, and toolchain'
                        'readers:List attached PC/SC and USB CCID smartcard readers'
                        'atr:Parse and decode ISO/IEC 7816-3 Answer-to-Reset'
                        'trace:Osmocom SIMtrace 2 probe inspection and APDU sniffing'
                        'lpac:eSIM Local Profile Assistant profile and chip manager'
                        'shell:Launch interactive Osmocom pySim-shell console'
                    )
                    _arguments -C \
                        '1: :->sim_subcmd' \
                        '*:: :->sim_args'
                    case $state in
                        sim_subcmd)
                            _describe -t sim_subcmds 'sim command' sim_subcmds
                            ;;
                        sim_args)
                            case $words[1] in
                                trace|simtrace)
                                    local -a trace_subcmds
                                    trace_subcmds=(
                                        'list:List attached Osmocom SIMtrace hardware probes'
                                        'sniff:Stream live APDU traffic via GSMTAP to Wireshark'
                                    )
                                    _describe -t trace_subcmds 'trace action' trace_subcmds
                                    ;;
                                lpac|esim)
                                    local -a lpac_subcmds
                                    lpac_subcmds=(
                                        'status:Show general lpac status and installed drivers'
                                        'chip:Query eUICC chip EID and capabilities'
                                        'profiles:List installed eSIM profiles on target chip'
                                        'drivers:Enumerate available APDU and HTTP drivers'
                                    )
                                    _describe -t lpac_subcmds 'lpac action' lpac_subcmds
                                    ;;
                                status|readers|atr)
                                    _arguments '--json[Output results in structured JSON format]'
                                    ;;
                            esac
                            ;;
                    esac
                    ;;
                pkg|package|packages)
                    local -a pkg_subcmds metapackages
                    pkg_subcmds=(
                        'list:List all available and installed metapackage suites'
                        'info:Display tool manifest and dependency breakdown'
                        'install:Deploy a modular metapackage suite to system'
                        'remove:Remove a metapackage suite from system'
                        'check:Verify installed metapackage integrity and dpkg state'
                        'repo:Inspect or configure meta.telcochisel.com repository'
                    )
                    metapackages=(
                        'base:Core OS kernel latency tuning, PAM limits, SCTP stack'
                        'hardware:SDR USB udev rules & FPGA bitstream loaders'
                        'sdr:RF signal analysis, DSP flowgraphs & Satcom suite'
                        '2g-3g:Cellular 2G/3G Osmocom infrastructure & OpenBTS'
                        '4g:4G LTE eNodeB/EPC simulation & protocol audit'
                        '5g:5G SA Core (Open5GS), UERANSIM & 5Ghoul fuzzer'
                        'sim:SIM & eSIM auditing suite (pySim, SIMtrace 2, lpac)'
                        'wireline:Wireline broadband, VoIP, QinQ & mausezahn'
                        'ue:Mobile UE & baseband diagnostics (SCAT, QCSuper)'
                        'full:Complete TelcoChisel telecom distribution (100 tools)'
                    )
                    if (( CURRENT == 2 )); then
                        _describe -t pkg_subcmds 'pkg action' pkg_subcmds
                        _describe -t metapackages 'metapackage suite' metapackages
                    elif (( CURRENT == 3 )); then
                        case $words[2] in
                            info|install|remove|purge|show)
                                _describe -t metapackages 'metapackage suite' metapackages
                                ;;
                            list|ls)
                                _arguments '--json[Output results as JSON]'
                                ;;
                            repo)
                                local -a repo_subcmds
                                repo_subcmds=('status:Check repository sources and CDN reachability' 'enable:Enroll system in official APT repo')
                                _describe -t repo_subcmds 'repo action' repo_subcmds
                                ;;
                        esac
                    fi
                    ;;
                sdr)
                    local -a sdr_subcmds
                    sdr_subcmds=(
                        'status:Audit attached USB SDRs and serial AT modems'
                        'usb:Check and tune USB buffer limits (usbfs_memory_mb)'
                        '10g:10Gbps network transceiver diagnostics and tuning'
                        'firmware:Inspect local offline FPGA bitstream caches'
                    )
                    if (( CURRENT == 2 )); then
                        _describe -t sdr_subcmds 'sdr action' sdr_subcmds
                    elif [[ $words[2] == "10g" ]]; then
                        if (( CURRENT == 3 )); then
                            local -a sub10g
                            sub10g=('status:Inspect 10GbE NICs' 'tune:Optimize MTU 9000 & rings' 'setup:Configure IP and tune' 'probe:Probe USRP on network')
                            _describe -t sub10g '10g action' sub10g
                        elif (( CURRENT == 4 )) && [[ $words[3] == "tune" || $words[3] == "setup" ]]; then
                            _telcosec_interfaces
                        elif (( CURRENT == 5 )) && [[ $words[3] == "setup" ]]; then
                            local -a presets
                            presets=('x310-0:192.168.10.1/24' 'x310-1:192.168.20.1/24' 'n310-0:192.168.10.1/24' 'n310-1:192.168.20.1/24')
                            _describe -t presets 'USRP preset' presets
                        fi
                    fi
                    ;;
                10g|10gbe|network)
                    if (( CURRENT == 2 )); then
                        local -a sub10g
                        sub10g=('status:Inspect 10GbE NICs' 'tune:Optimize MTU 9000 & rings' 'setup:Configure IP and tune' 'probe:Probe USRP on network')
                        _describe -t sub10g '10g action' sub10g
                    elif (( CURRENT == 3 )) && [[ $words[2] == "tune" || $words[2] == "setup" ]]; then
                        _telcosec_interfaces
                    elif (( CURRENT == 4 )) && [[ $words[2] == "setup" ]]; then
                        local -a presets
                        presets=('x310-0:192.168.10.1/24' 'x310-1:192.168.20.1/24' 'n310-0:192.168.10.1/24' 'n310-1:192.168.20.1/24')
                        _describe -t presets 'USRP preset' presets
                    fi
                    ;;
                5g|5g-sa|5gsa)
                    if (( CURRENT == 2 )); then
                        local -a sub5g
                        sub5g=('start:Start Open5GS 5G SA core daemons' 'stop:Stop Open5GS services' 'status:Check AMF and UPF status' 'add-sub:Provision 5G test subscriber')
                        _describe -t sub5g '5g action' sub5g
                    fi
                    ;;
                profile)
                    if (( CURRENT == 2 )); then
                        local -a subprof
                        subprof=('status:Show current rp_filter profile' 'lab:Unrestricted packet crafting (rp_filter=0)' 'field:Hardened reverse path filtering (rp_filter=1)')
                        _describe -t subprof 'profile mode' subprof
                    fi
                    ;;
                scan)
                    if (( CURRENT == 2 )); then
                        local -a subscan
                        subscan=('sctp:SCTP signaling port scanner (sctpscan)' 'sip:SIP scanner and extension mapper (svmap)' 'asleap:PPPoE and MS-CHAPv2 assessment')
                        _describe -t subscan 'protocol' subscan
                    fi
                    ;;
                completion)
                    if (( CURRENT == 2 )); then
                        local -a shells
                        shells=('bash:Generate Bash completion script' 'zsh:Generate Zsh completion script' 'fish:Generate Fish completion script')
                        _describe -t shells 'shell' shells
                    fi
                    ;;
            esac
            ;;
    esac
}

_telcosec "$@"
